@page "/categories"

<PageTitle>Categories</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="categories-page">
            <h3 class="mb-4">Choose a category</h3>

            <div class="row g-3">
                @foreach (var category in categories) {
                    <div class="col-12 col-sm-6 col-lg-4">
                        <div class="card category-card h-100">
                            <div class="card-body d-flex flex-column gap-2">
                                <div>
                                    <h5 class="card-title mb-1">@category.Name</h5>
                                    <div class="card-text text-secondary small">@category.Description</div>
                                </div>

                                <div class="category-meta mt-auto">
                                    <span class="badge text-bg-primary">@category.QuestionCount questions</span>
                                    <span class="badge text-bg-secondary">@category.SubCategoriesCount subcategories</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <p>You must be logged in to view this page.</p>
        <NavLink class="btn btn-primary" href="login">Go to Login</NavLink>
    </NotAuthorized>
</AuthorizeView>

@code {
    List<Category> categories = new List<Category> {
        new Category {
            Id = 1,
            Name = "General Knowledge",
            Description = "Test your general knowledge across various topics.",
            QuestionCount = 100,
            SubCategoriesCount = 5 },
        new Category {
            Id = 2,
            Name = "Science",
            Description = "Explore the wonders of science with questions on physics, chemistry, and biology.",
            QuestionCount = 80,
            SubCategoriesCount = 4 },
        new Category {
            Id = 3,
            Name = "History",
            Description = "Dive into the past with questions about historical events and figures.",
            QuestionCount = 70,
            SubCategoriesCount = 3 },
        new Category {
            Id = 4,
            Name = "Geography",
            Description = "Challenge your knowledge of world geography and landmarks.",
            QuestionCount = 60,
            SubCategoriesCount = 2
        },
        new Category {
            Id = 5,
            Name = "Entertainment",
            Description = "Have fun with questions about movies, music, and pop culture.",
            QuestionCount = 90,
