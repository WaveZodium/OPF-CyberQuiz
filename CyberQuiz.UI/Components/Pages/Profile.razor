@page "/profile"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using Microsoft.AspNetCore.Mvc
@using CyberQuiz.Shared.DTOs.Profile
@using CyberQuiz.Shared.DTOs.Progress
@using CyberQuiz.UI.Services
@inject IApiClient ApiClient

<PageTitle>Profile</PageTitle>

<AuthorizeView>
    <Authorized Context="auth">
        <div class="profile-page page-content">
            <h3 class="mb-3">Profile</h3>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }
            else if (profile is null)
            {
                <div class="alert alert-info">Loading profile...</div>
            }
            else
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <div class="fw-semibold">Username</div>
                                <div>@profile.UserName</div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="fw-semibold">Email</div>
                                <div>@profile.Email</div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="fw-semibold">Member since</div>
                                <div>@profile.MemberSince.ToString("yyyy-MM-dd")</div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="fw-semibold">Completed subcategories</div>
                                <div>@profile.CompletedSubCategories / @profile.TotalSubCategories</div>
                            </div>
                        </div>

                        <hr />

                        <div class="row text-center">
                            <div class="col">
                                <div class="fw-semibold">Questions attempted</div>
                                <div>@profile.TotalQuestionsAttempted</div>
                            </div>
                            <div class="col">
                                <div class="fw-semibold text-success">Correct answers</div>
                                <div>@profile.TotalCorrectAnswers</div>
                            </div>
                            <div class="col">
                                <div class="fw-semibold">Accuracy</div>
                                <div>@profile.OverallAccuracy.ToString("0.#")%</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Change password card -->
                <div class="card mb-3">
                    <div class="card-body">
                        <h5>Change password</h5>
                        <EditForm Model="@_pwdModel" OnValidSubmit="HandleChangePassword" OnInvalidSubmit="HandleInvalidPasswordSubmit">
                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <div class="mb-3">
                                <label class="form-label">Current password</label>
                                <InputText type="password" class="form-control" @bind-Value="_pwdModel.CurrentPassword" />
                                <ValidationMessage For="@(() => _pwdModel.CurrentPassword)" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">New password</label>
                                <InputText type="password" class="form-control" @bind-Value="_pwdModel.NewPassword" />
                                <ValidationMessage For="@(() => _pwdModel.NewPassword)" />
                                <div class="small text-muted mt-1">
                                    Password must be at least 6 characters and include at least one non-alphanumeric character (e.g. !, @@, #).
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Confirm new password</label>
                                <InputText type="password" class="form-control" @bind-Value="_pwdModel.ConfirmPassword" />
                                <ValidationMessage For="@(() => _pwdModel.ConfirmPassword)" />
                            </div>

                            <div class="d-flex justify-content-center gap-3">
                                <button type="submit" class="btn btn-primary" disabled="@_pwdSubmitting">
                                    @(_pwdSubmitting ? "Please wait..." : "Update password")
                                </button>
                            </div>

                            @if (_pwdStatusMessage is not null)
                            {
                                <div class="alert alert-success mt-3" role="status">@_pwdStatusMessage</div>
                            }

                            @if (_pwdErrorMessage is not null)
                            {
                                <div class="alert alert-danger mt-3" role="alert">@_pwdErrorMessage</div>
                            }
                        </EditForm>
                    </div>
                </div>

                <!-- Change email card -->
                <div class="card mb-3">
                    <div class="card-body">
                        <h5>Change email</h5>
                        <EditForm Model="@_emailModel" OnValidSubmit="HandleChangeEmail" OnInvalidSubmit="HandleInvalidEmailSubmit">
                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <div class="mb-3">
                                <label class="form-label">Current password</label>
                                <InputText type="password" class="form-control" @bind-Value="_emailModel.Password" />
                                <ValidationMessage For="@(() => _emailModel.Password)" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">New email</label>
                                <InputText type="email" class="form-control" @bind-Value="_emailModel.NewEmail" />
                                <ValidationMessage For="@(() => _emailModel.NewEmail)" />
                            </div>

                            <div class="d-flex justify-content-center gap-3">
                                <button type="submit" class="btn btn-primary" disabled="@_emailSubmitting">
                                    @(_emailSubmitting ? "Please wait..." : "Update email")
                                </button>
                            </div>

                            @if (_emailStatusMessage is not null)
                            {
                                <div class="alert alert-success mt-3" role="status">@_emailStatusMessage</div>
                            }

                            @if (_emailErrorMessage is not null)
                            {
                                <div class="alert alert-danger mt-3" role="alert">@_emailErrorMessage</div>
                            }
                        </EditForm>
                    </div>
                </div>

                <br />
            }
        </div>
    </Authorized>
    <NotAuthorized Context="notAuth">
        <p>You must be logged in to view this page.</p>
        <NavLink class="btn btn-primary" href="/login">Go to Login</NavLink>
    </NotAuthorized>
</AuthorizeView>

@code {
    private UserProfileDto? profile;
    private List<CategoryProgressDto> categoryProgress = [];
    private string? errorMessage;

    // Change-password state
    private readonly ChangePasswordModel _pwdModel = new();
    private bool _pwdSubmitting;
    private string? _pwdStatusMessage;
    private string? _pwdErrorMessage;

    // Change-email state
    private readonly ChangeEmailModel _emailModel = new();
    private bool _emailSubmitting;
    private string? _emailStatusMessage;
    private string? _emailErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadProfileAsync();
    }

    private async Task LoadProfileAsync()
    {
        try
        {
            errorMessage = null;
            profile = await ApiClient.HttpClient.GetFromJsonAsync<UserProfileDto>("api/profile");
            categoryProgress = await ApiClient.HttpClient
                .GetFromJsonAsync<List<CategoryProgressDto>>("api/profile/categories")
                ?? [];
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            profile = null;
            categoryProgress = [];
        }
    }

    // Password handler (already shows concise messages)
    private async Task HandleChangePassword()
    {
        _pwdStatusMessage = null;
        _pwdErrorMessage = null;
        _pwdSubmitting = true;

        var payload = new { CurrentPassword = _pwdModel.CurrentPassword, NewPassword = _pwdModel.NewPassword };

        try
        {
            var response = await ApiClient.HttpClient.PostAsJsonAsync("api/auth/change-password", payload);

            if (response.IsSuccessStatusCode)
            {
                _pwdStatusMessage = "Password changed successfully.";
                _pwdModel.CurrentPassword = _pwdModel.NewPassword = _pwdModel.ConfirmPassword = string.Empty;
                return;
            }

            var content = await response.Content.ReadAsStringAsync();
            var mediaType = response.Content.Headers.ContentType?.MediaType;

            // If content looks like JSON, try to parse ValidationProblemDetails safely
            if (!string.IsNullOrWhiteSpace(content) &&
                (content.TrimStart().StartsWith("{") || (mediaType?.Contains("json", StringComparison.OrdinalIgnoreCase) == true)))
            {
                try
                {
                    var problem = JsonSerializer.Deserialize<ValidationProblemDetails?>(content, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                    if (problem?.Errors is not null && problem.Errors.Count > 0)
                    {
                        var messages = problem.Errors.SelectMany(kv => kv.Value).Distinct();
                        _pwdErrorMessage = string.Join(" ", messages);
                    }
                    else
                    {
                        _pwdErrorMessage = TryExtractServerErrors(content) ?? content;
                    }
                }
                catch
                {
                    // parsing failed — fallback to friendly extraction or plain text
                    _pwdErrorMessage = TryExtractServerErrors(content) ?? content;
                }
            }
            else
            {
                // plain text response
                _pwdErrorMessage = content.Trim();
            }
        }
        catch (Exception ex)
        {
            _pwdErrorMessage = ex.Message; // no stack trace
        }
        finally
        {
            _pwdSubmitting = false;
        }
    }

    private void HandleInvalidPasswordSubmit(EditContext editContext)
    {
        _pwdStatusMessage = null;
        var invalid = new List<string>();
        if (editContext.GetValidationMessages(() => _pwdModel.CurrentPassword).Any()) invalid.Add("Current password");
        if (editContext.GetValidationMessages(() => _pwdModel.NewPassword).Any()) invalid.Add("New password");
        if (editContext.GetValidationMessages(() => _pwdModel.ConfirmPassword).Any()) invalid.Add("Confirm password");
        _pwdErrorMessage = invalid.Count == 0 ? "Please correct the highlighted fields." : $"Please check: {string.Join(", ", invalid)}.";
    }

    // Email handler updated to match password handler behaviour and show concise server errors
    private async Task HandleChangeEmail()
    {
        _emailStatusMessage = null;
        _emailErrorMessage = null;
        _emailSubmitting = true;

        var payload = new { Password = _emailModel.Password, NewEmail = _emailModel.NewEmail };

        try
        {
            var response = await ApiClient.HttpClient.PostAsJsonAsync("api/auth/change-email", payload);

            if (response.IsSuccessStatusCode)
            {
                _emailStatusMessage = "Email changed successfully.";
                if (profile is not null) profile.Email = _emailModel.NewEmail;
                _emailModel.Password = _emailModel.NewEmail = string.Empty;
                return;
            }

            var content = await response.Content.ReadAsStringAsync();
            var mediaType = response.Content.Headers.ContentType?.MediaType;

            if (!string.IsNullOrWhiteSpace(content) &&
                (content.TrimStart().StartsWith("{") || (mediaType?.Contains("json", StringComparison.OrdinalIgnoreCase) == true)))
            {
                try
                {
                    var problem = JsonSerializer.Deserialize<ValidationProblemDetails?>(content, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                    if (problem?.Errors is not null && problem.Errors.Count > 0)
                    {
                        var messages = problem.Errors.SelectMany(kv => kv.Value).Distinct();
                        _emailErrorMessage = string.Join(" ", messages);
                    }
                    else
                    {
                        _emailErrorMessage = TryExtractServerErrors(content) ?? content;
                    }
                }
                catch
                {
                    _emailErrorMessage = TryExtractServerErrors(content) ?? content;
                }
            }
            else
            {
                _emailErrorMessage = content.Trim();
            }
        }
        catch (Exception ex)
        {
            _emailErrorMessage = ex.Message;
        }
        finally
        {
            _emailSubmitting = false;
        }
    }

    private void HandleInvalidEmailSubmit(EditContext editContext)
    {
        _emailStatusMessage = null;
        var invalid = new List<string>();
        if (editContext.GetValidationMessages(() => _emailModel.Password).Any()) invalid.Add("Password");
        if (editContext.GetValidationMessages(() => _emailModel.NewEmail).Any()) invalid.Add("New email");
        _emailErrorMessage = invalid.Count == 0 ? "Please correct the highlighted fields." : $"Please check: {string.Join(", ", invalid)}.";
    }

    private static string? TryExtractServerErrors(string message)
    {
        if (string.IsNullOrWhiteSpace(message))
            return null;

        var firstBrace = message.IndexOf('{');
        if (firstBrace < 0)
            return null;

        var json = message[firstBrace..];
        try
        {
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;

            if (root.TryGetProperty("errors", out var errorsElement) && errorsElement.ValueKind == JsonValueKind.Object)
            {
                var list = new List<string>();
                foreach (var prop in errorsElement.EnumerateObject())
                {
                    if (prop.Value.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var item in prop.Value.EnumerateArray())
                        {
                            if (item.ValueKind == JsonValueKind.String)
                                list.Add(item.GetString() ?? string.Empty);
                        }
                    }
                }

                if (list.Count > 0)
                    return string.Join(" ", list);
            }

            if (root.TryGetProperty("title", out var titleProp) && titleProp.ValueKind == JsonValueKind.String)
                return titleProp.GetString();
        }
        catch
        {
            // ignore parse errors
        }

        return null;
    }

    private sealed class ChangePasswordModel
    {
        [Required]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required, MinLength(6)]
        [RegularExpression(@"^(?=.*\W).+$", ErrorMessage = "Password must contain at least one non-alphanumeric character.")]
        public string NewPassword { get; set; } = string.Empty;

        [Required, Compare(nameof(NewPassword), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    private sealed class ChangeEmailModel
    {
        [Required]
        public string Password { get; set; } = string.Empty;

        [Required, EmailAddress]
        public string NewEmail { get; set; } = string.Empty;
    }

    private static decimal ClampPercent(decimal value)
        => Math.Clamp(value, 0m, 100m);
}
