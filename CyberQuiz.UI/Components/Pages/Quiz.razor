@page "/quiz/{SubCategoryId:int}"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using CyberQuiz.Shared.DTOs.Quiz
@using CyberQuiz.UI.Services
@inject IApiClient ApiClient

<PageTitle>Questions</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="quiz-page">
            <NavLink class="btn btn-link px-0 mb-3" href="/categories">← Back to categories</NavLink>

            <h3 class="mb-3">Questions</h3>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }
            else if (questions.Count == 0)
            {
                <div class="alert alert-info">No questions found for this subcategory.</div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @for (var i = 0; i < questions.Count; i++)
                    {
                        var question = questions[i];

                        <div class="card question-card">
                            <div class="card-body">
                                @* <h5 class="card-title">Question @(i + 1)</h5> *@
                                <h5 class="card-title">Question @questionId</h5>
                                <p class="card-text">@question.Text</p>

                                <fieldset class="answer-group" aria-label="@($"Answers for question {i + 1}")">
                                    @foreach (var option in question.AnswerOptions)
                                    {
                                        <label class="answer-option">
                                            <input type="radio"
                                                   name="@($"q-{question.QuestionId}")"
                                                   value="@option.Id"
                                                   checked="@IsSelected(question.QuestionId, option.Id)"
                                                   @onchange="@(() => SelectOption(question.QuestionId, option.Id))" />
                                            <span>@option.Text</span>
                                        </label>
                                    }
                                </fieldset>

                                <div class="d-flex gap-2 mt-3">
                                    <button class="btn btn-primary"
                                            @onclick="() => SubmitAnswerAsync(question.QuestionId)"
                                            disabled="@(!hasSelectedAnswer || hasSubmittedCurrentQuestion)">
                                        Submit answer
                                    </button>

                                    <button class="btn btn-outline-primary"
                                            @onclick="GoToNextQuestionAsync"
                                            disabled="@(!hasSubmittedCurrentQuestion)">
                                        Next question
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <p>You must be logged in to view this page.</p>
        <NavLink class="btn btn-primary" href="/login">Go to Login</NavLink>
    </NotAuthorized>
</AuthorizeView>

<br />
<br />
<h5>Debug</h5>
subCategoryId: @SubCategoryId,
<br />
questionId: @questionId,
<br />
selectedAnswerOptionId: @selectedAnswerOptionId
<br />

@code {
    [Parameter]
    public int SubCategoryId { get; set; }

    private List<QuestionDto> questions = [];
    private string? errorMessage;
    private readonly Dictionary<int, int> selectedAnswersByQuestion = [];

    public int? questionId { get; set; }
    public int? selectedAnswerOptionId { get; set; }

    private bool hasSelectedAnswer;
    private bool hasSubmittedCurrentQuestion;

    protected override async Task OnParametersSetAsync()
    {
        await LoadNextQuestionAsync();
    }

    private async Task LoadNextQuestionAsync()
    {
        try
        {
            errorMessage = null;
            var nextQuestion = await ApiClient.HttpClient.GetFromJsonAsync<QuestionDto>($"api/quiz/next/{SubCategoryId}");
            questions = nextQuestion is null ? [] : [nextQuestion];
            selectedAnswersByQuestion.Clear();

            questionId = nextQuestion?.QuestionId;
            selectedAnswerOptionId = null;
            hasSelectedAnswer = false;
            hasSubmittedCurrentQuestion = false;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            questions = [];
            selectedAnswersByQuestion.Clear();
            questionId = null;
            selectedAnswerOptionId = null;
            hasSelectedAnswer = false;
            hasSubmittedCurrentQuestion = false;
        }
    }

    private bool IsSelected(int questionId, int optionId)
        => selectedAnswersByQuestion.TryGetValue(questionId, out var selectedOptionId) && selectedOptionId == optionId;

    private void SelectOption(int questionId, int optionId)
    {
        selectedAnswersByQuestion[questionId] = optionId;
        selectedAnswerOptionId = optionId;
        hasSelectedAnswer = true;
        hasSubmittedCurrentQuestion = false; // nytt val => måste submit igen
    }

    private async Task SubmitAnswerAsync(int questionId)
    {
        if (!hasSelectedAnswer || selectedAnswerOptionId is null)
            return;

        try
        {
            errorMessage = null;

            var dto = new SubmitAnswerRequestDto
            {
                SubCategoryId = SubCategoryId,
                QuestionId = questionId,
                SelectedAnswerOptionId = selectedAnswerOptionId.Value
            };

            var response = await ApiClient.HttpClient.PostAsJsonAsync("api/quiz/answer", dto);
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await response.Content.ReadAsStringAsync();
                return;
            }

            hasSubmittedCurrentQuestion = true;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task GoToNextQuestionAsync()
    {
        if (!hasSubmittedCurrentQuestion)
            return;

        await LoadNextQuestionAsync();
    }
}