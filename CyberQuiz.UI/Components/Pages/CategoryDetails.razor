@page "/categories/{CategoryId:int}"
@using CyberQuiz.Shared.DTOs.Catalog
@using CyberQuiz.UI.Services
@inject IApiClient ApiClient

<PageTitle>Category</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="category-details-page">
            <NavLink class="btn btn-link px-0 mb-3" href="/categories">← Back to categories</NavLink>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }
            else if (selectedCategory is null)
            {
                <div class="alert alert-warning">Category not found.</div>
            }
            else
            {
                <h3 class="mb-1">@selectedCategory.Name</h3>
                <p class="text-secondary mb-4">Select a subcategory</p>

                <div class="row g-3">
                    @foreach (var subCategory in selectedCategory.SubCategories.OrderBy(sc => sc.OrderIndex))
                    {
                        <div class="col-12 col-md-6 col-xl-4">
                            @if (subCategory.IsLocked)
                            {
                                <div class="card subcategory-card h-100 is-locked">
                                    <div class="card-body d-flex flex-column gap-2">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <h5 class="card-title mb-0">@subCategory.Name</h5>
                                            <span class="badge text-bg-secondary">Locked</span>
                                        </div>

                                        <div class="small text-secondary">
                                            Answered: @subCategory.ProgressPercent.ToString("0.#")%<br/>
                                            Score: Answer all questions to see score<br />
                                        </div>

                                        <div class="subcategory-meta mt-auto">
                                            <span class="badge text-bg-secondary">@subCategory.TotalQuestions questions</span>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <NavLink class="subcategory-card-link text-decoration-none"
                                         href="@((subCategory.IsCompleted || subCategory.ProgressPercent == 100)
                                             ? $"/review/{subCategory.Id}"
                                             : $"/quiz/{subCategory.Id}")">
                                    <div class="card subcategory-card h-100">
                                        <div class="card-body d-flex flex-column gap-2">
                                            <div class="d-flex justify-content-between align-items-start gap-2">
                                                <h5 class="card-title mb-0">@subCategory.Name</h5>

                                                @if (subCategory.IsCompleted)
                                                {
                                                    <span class="badge text-bg-success">Completed</span>
                                                }
                                                else
                                                {
                                                    <span class="badge text-bg-primary">Open</span>
                                                }
                                            </div>

                                            <div class="small text-secondary">
                                                Answered: @subCategory.ProgressPercent.ToString("0.#")%<br />
                                                Score: @subCategory.PercentCorrect.ToString("0.#")%<br />
                                            </div>

                                            <div class="subcategory-meta mt-auto">
                                                <span class="badge text-bg-secondary">@subCategory.TotalQuestions questions</span>
                                            </div>
                                        </div>
                                    </div>
                                </NavLink>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <p>You must be logged in to view this page.</p>
        <NavLink class="btn btn-primary" href="/login">Go to Login</NavLink>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public int CategoryId { get; set; }

    private CategoryDto? selectedCategory;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            errorMessage = null;

            var categories = await ApiClient.HttpClient.GetFromJsonAsync<List<CategoryDto>>("api/categories") ?? [];
            selectedCategory = categories.FirstOrDefault(c => c.Id == CategoryId);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            selectedCategory = null;
        }
    }
}