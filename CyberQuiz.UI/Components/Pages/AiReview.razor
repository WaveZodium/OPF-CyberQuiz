@page "/ai-review"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using CyberQuiz.Shared.DTOs.AICoach
@using CyberQuiz.UI.Services
@inject IApiClient ApiClient

<PageTitle>AI Review</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="ai-review-page page-content">
            <h3 class="mb-3">AI Review</h3>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }
            else if (isLoading)
            {
                <div class="card mb-3">
                    <div class="card-body d-flex flex-column align-items-center justify-content-center py-5 text-center">
                        <div class="spinner-border text-primary mb-3" role="status" aria-hidden="true"></div>
                        <div class="fw-semibold">Generating your AI review…</div>
                        <div class="text-secondary small">This can take a moment.</div>
                    </div>
                </div>
            }
            else
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <h5 class="mb-3">Summary</h5>
                        <div class="row text-center">
                            <div class="col">
                                <div class="fw-semibold">Questions answered</div>
                                <div>@summary?.TotalQuestionsAnswered</div>
                            </div>
                            <div class="col">
                                <div class="fw-semibold text-success">Correct answers</div>
                                <div>@summary?.TotalCorrectAnswers</div>
                            </div>
                            <div class="col">
                                <div class="fw-semibold">Accuracy</div>
                                <div>@OverallAccuracyLabel</div>
                            </div>
                        </div>

                        <div class="progress mt-3 position-relative" role="progressbar"
                             aria-valuenow="@ClampPercent(summary?.OverallAccuracy ?? 0)"
                             aria-valuemin="0"
                             aria-valuemax="100">
                            <div class="progress-bar bg-success progress-animate"
                                 style="@($"--progress-value: {OverallAccuracyLabel}")"></div>
                            <span class="position-absolute w-100 text-center small fw-semibold text-dark">
                                @OverallAccuracyLabel
                            </span>
                        </div>
                    </div>
                </div>

                <h4 class="mb-3">Performance by subcategory</h4>

                @if (Performances.Count == 0)
                {
                    <div class="alert alert-info">No quiz attempts yet.</div>
                }
                else
                {
                    @foreach (var perf in Performances)
                    {
                        var accuracy = ClampPercent(perf.AccuracyPercentage);
                        var accuracyLabel = $"{accuracy:0.#}%";
                        var lastAttemptLabel = perf.LastAttemptDate?.ToString("yyyy-MM-dd") ?? "N/A";

                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div>
                                        <h5 class="mb-1">@perf.CategoryName > @perf.SubCategoryName</h5>
                                        <div class="text-secondary small">
                                            Attempted @perf.QuestionsAttempted / @perf.TotalAvailableQuestions ·
                                            Last attempt @lastAttemptLabel
                                        </div>
                                    </div>
                                    <span class="badge text-bg-primary">@accuracyLabel</span>
                                </div>

                                <div class="progress mt-3 position-relative" role="progressbar"
                                     aria-valuenow="@accuracy"
                                     aria-valuemin="0"
                                     aria-valuemax="100">
                                    <div class="progress-bar bg-info progress-animate"
                                         style="@($"--progress-value: {accuracyLabel}")"></div>
                                    <span class="position-absolute w-100 text-center small fw-semibold text-dark">
                                        Accuracy @accuracyLabel
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                }

                <h4 class="mb-3">Coach feedback</h4>

                <div class="card mb-3">
                    <div class="card-body">
                        <div class="mb-3">
                            <div class="fw-semibold">Overall assessment</div>
                            <div>@feedback?.OverallAssessment</div>
                        </div>

                        <div class="row">
                            <div class="col-12 col-md-6 mb-3">
                                <div class="fw-semibold">Strengths</div>
                                @if (Strengths.Count == 0)
                                {
                                    <div class="text-secondary small">No strengths listed yet.</div>
                                }
                                else
                                {
                                    <ul class="mb-0">
                                        @foreach (var item in Strengths)
                                        {
                                            <li>@item</li>
                                        }
                                    </ul>
                                }
                            </div>
                            <div class="col-12 col-md-6 mb-3">
                                <div class="fw-semibold">Weaknesses</div>
                                @if (Weaknesses.Count == 0)
                                {
                                    <div class="text-secondary small">No weaknesses listed yet.</div>
                                }
                                else
                                {
                                    <ul class="mb-0">
                                        @foreach (var item in Weaknesses)
                                        {
                                            <li>@item</li>
                                        }
                                    </ul>
                                }
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="fw-semibold">Recommendations</div>
                            @if (Recommendations.Count == 0)
                            {
                                <div class="text-secondary small">No recommendations right now.</div>
                            }
                            else
                            {
                                <ul class="mb-0">
                                    @foreach (var rec in Recommendations)
                                    {
                                        <li>
                                            <strong>@rec.CategoryName > @rec.SubCategoryName</strong> — @rec.Reason
                                        </li>
                                    }
                                </ul>
                            }
                        </div>

                        <div class="alert alert-info mb-0">
                            <div class="fw-semibold">Motivation</div>
                            <div>@feedback?.MotivationalMessage</div>
                        </div>

                        <div class="text-secondary small mt-2">
                            Generated @feedback?.GeneratedAt.ToString("yyyy-MM-dd HH:mm")
                        </div>
                    </div>
                </div>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <p>You must be logged in to view this page.</p>
        <NavLink class="btn btn-primary" href="/login">Go to Login</NavLink>
    </NotAuthorized>
</AuthorizeView>

@code {
    private UserQuizSummaryDto? summary;
    private AICoachFeedbackDto? feedback;
    private string? errorMessage;
    private bool isLoading = true;

    private IReadOnlyList<SubCategoryPerformanceDto> Performances
        => summary?.SubCategoryPerformances ?? [];

    private IReadOnlyList<string> Strengths
        => feedback?.Strengths ?? [];

    private IReadOnlyList<string> Weaknesses
        => feedback?.Weaknesses ?? [];

    private IReadOnlyList<RecommendationDto> Recommendations
        => feedback?.Recommendations ?? [];

    private string OverallAccuracyLabel
        => summary is null ? "0%" : $"{ClampPercent(summary.OverallAccuracy):0.#}%";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadAiReviewAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAiReviewAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            summary = null;
            feedback = null;

            summary = await ApiClient.HttpClient.GetFromJsonAsync<UserQuizSummaryDto>("api/coach/summary");
            feedback = await ApiClient.HttpClient.GetFromJsonAsync<AICoachFeedbackDto>("api/coach/feedback");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            summary = null;
            feedback = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private static double ClampPercent(double value)
        => Math.Clamp(value, 0d, 100d);
}
