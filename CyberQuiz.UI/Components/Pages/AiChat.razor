@page "/ai-chat"
@rendermode InteractiveServer
@using System.Net
@using System.Net.Http.Json
@using CyberQuiz.Shared.DTOs.AiChat
@using CyberQuiz.UI.Services
@inject IApiClient ApiClient
@inject AiChatState ChatState

<PageTitle>AI Chat</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="ai-chat-page page-content">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="mb-0">AI Chat</h3>
                <button class="btn btn-outline-secondary"
                        type="button"
                        @onclick="ResetConversation"
                        disabled="@isSending">
                    Reset conversation
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <div class="card mb-3">
                <div class="card-body">
                    @if (History.Count == 0)
                    {
                        <div class="text-secondary small">No messages yet. Start a conversation.</div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var chat in History)
                            {
                                var isUser = chat.Role.Equals("user", StringComparison.OrdinalIgnoreCase);

                                <div class="d-flex @(isUser ? "justify-content-end" : "justify-content-start")">
                                    <div class="border rounded p-2 @(isUser ? "bg-primary text-white" : "bg-light")" style="max-width: 80%;">
                                        <div class="small text-uppercase fw-semibold @(isUser ? "text-white-50" : "text-secondary")">
                                            @chat.Role
                                            @if (chat.Timestamp != default)
                                            {
                                                <span class="ms-2 text-opacity-75">@FormatTimestamp(chat.Timestamp)</span>
                                            }
                                        </div>
                                        @if (isUser)
                                        {
                                            <div>@chat.Content</div>
                                        }
                                        else
                                        {
                                            <div>@FormatChatReply(chat.Content)</div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <div class="input-group">
                        <input class="form-control"
                               placeholder="Ask a cybersecurity question..."
                               @bind="message"
                               @bind:event="oninput"
                               disabled="@isSending" />
                        <button class="btn btn-primary"
                                type="button"
                                @onclick="SendMessageAsync"
                                disabled="@isSending">
                            @(isSending ? "Sending..." : "Send")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <p>You must be logged in to view this page.</p>
        <NavLink class="btn btn-primary" href="/login">Go to Login</NavLink>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string message = string.Empty;
    private string? errorMessage;
    private bool isSending;

    private List<ChatMessageDto> History => ChatState.History;

    private async Task SendMessageAsync()
    {
        if (isSending || string.IsNullOrWhiteSpace(message))
            return;

        try
        {
            isSending = true;
            errorMessage = null;

            var userMessage = new ChatMessageDto
            {
                Role = "user",
                Content = message.Trim(),
                Timestamp = DateTimeOffset.Now
            };

            History.Add(userMessage);

            var request = new ChatRequestDto
            {
                Message = userMessage.Content,
                History = [.. History]
            };

            var response = await ApiClient.HttpClient.PostAsJsonAsync("api/ai/chat", request);
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await response.Content.ReadAsStringAsync();
                return;
            }

            var chatResponse = await response.Content.ReadFromJsonAsync<ChatResponseDto>();
            if (chatResponse is null)
            {
                errorMessage = "Empty response from AI.";
                return;
            }

            History.Add(new ChatMessageDto
            {
                Role = "assistant",
                Content = chatResponse.Reply,
                Timestamp = DateTimeOffset.Now
            });

            message = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSending = false;
        }
    }

    private void ResetConversation()
    {
        ChatState.Clear();
        message = string.Empty;
        errorMessage = null;
    }

    private static MarkupString FormatChatReply(string reply)
    {
        var encoded = WebUtility.HtmlEncode(reply);
        var withBreaks = encoded
            .Replace("\r\n", "\n")
            .Replace("\n", "<br />");

        return new MarkupString(withBreaks);
    }

    private static string FormatTimestamp(DateTimeOffset timestamp)
        => timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
}