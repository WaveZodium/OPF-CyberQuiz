@page "/register"
@using System.ComponentModel.DataAnnotations

<div class="login-page">
    <div class="login-card">
        <h3>Register</h3>

        <EditForm Model="_model" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label for="identifier" class="form-label">Username or Email</label>
                <InputText id="identifier" class="form-control" @bind-Value="_model.Identifier" />
                <ValidationMessage For="@(() => _model.Identifier)" />
            </div>

            <div class="mb-2">
                <label for="password" class="form-label">Password</label>
                <InputText id="password" type="password" class="form-control" @bind-Value="_model.Password" />
                <ValidationMessage For="@(() => _model.Password)" />
            </div>

            <div class="mb-3">
                <NavLink class="btn btn-link p-0" href="/forgot-password">Forgot password?</NavLink>
            </div>

            <div class="d-flex justify-content-center gap-3">
                <NavLink class="btn btn-secondary" href="/register">Register</NavLink>
            </div>
            
            <div class="mb-3 mt-3 text-center">
                Already have an account? <NavLink class="btn btn-link p-0" href="/login">Login</NavLink>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private readonly LoginModel _model = new();

    private Task HandleLogin()
    {
        // TODO: Replace with real auth flow (no JWT per project guidelines).
        return Task.CompletedTask;
    }

    private sealed class LoginModel
    {
        [Required]
        public string Identifier { get; set; } = string.Empty;

        [Required, MinLength(6)]
        public string Password { get; set; } = string.Empty;
    }
}
