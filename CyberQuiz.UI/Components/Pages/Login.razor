@page "/login"
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@inject HttpClient Http

<div class="login-page">
    <div class="login-card">
        <h3>Login</h3>

        <EditForm Model="_model" FormName="LoginForm" OnValidSubmit="HandleLogin" OnInvalidSubmit="HandleInvalidSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label for="identifier" class="form-label">Username or Email</label>
                <InputText id="identifier" class="form-control" @bind-Value="_model.Identifier" />
                <ValidationMessage For="@(() => _model.Identifier)" />
            </div>

            <div class="mb-2">
                <label for="password" class="form-label">Password</label>
                <InputText id="password" type="password" class="form-control" @bind-Value="_model.Password" />
                <ValidationMessage For="@(() => _model.Password)" />
            </div>

            <div class="mb-3">
                <NavLink class="btn btn-link p-0" href="/forgot-password">Forgot password?</NavLink>
            </div>

            <div class="d-flex justify-content-center gap-3">
                <button type="submit" class="btn btn-primary">
                    @(_isSubmitting ? "Logging in..." : "Login")
                </button>
                <NavLink class="btn btn-secondary" href="/register">Register</NavLink>
            </div>

            @if (_statusMessage is not null)
            {
                <div class="alert alert-success mt-3" role="status">@_statusMessage</div>
            }

            @if (_errorMessage is not null)
            {
                <div class="alert alert-danger mt-3" role="alert">@_errorMessage</div>
            }
        </EditForm>
    </div>
</div>

@code {
    private readonly LoginModel _model = new();
    private bool _useApi = false;
    private bool _isSubmitting;
    private string? _statusMessage;
    private string? _errorMessage;

    private async Task HandleLogin()
    {
        _errorMessage = null;
        _statusMessage = null;
        _isSubmitting = true;

        var request = new LoginRequest(_model.Identifier, _model.Password);

        try
        {
            if (_useApi)
            {
                var response = await Http.PostAsJsonAsync("/api/login", request);
                response.EnsureSuccessStatusCode();
                _statusMessage = "Logged in.";
            }
            else
            {
                await Task.Delay(350);
                _statusMessage = "Logged in (simulated).";
            }
        }
        catch
        {
            _errorMessage = "Login failed.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void HandleInvalidSubmit()
    {
        _statusMessage = null;
        _errorMessage = "Please enter a username/email and a password (min 6 characters).";
    }
    
    private sealed class LoginModel
    {
        [Required]
        public string Identifier { get; set; } = string.Empty;

        [Required, MinLength(6)]
        public string Password { get; set; } = string.Empty;
    }

    private sealed record LoginRequest(string Identifier, string Password);
}
