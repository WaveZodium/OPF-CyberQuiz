@page "/quiz/{SubCategoryId:int}"
@rendermode InteractiveServer
@using System.Net
@using Microsoft.AspNetCore.Components
@using CyberQuiz.Shared.DTOs.AiChat
@using CyberQuiz.Shared.DTOs.Catalog
@using CyberQuiz.Shared.DTOs.Quiz
@using CyberQuiz.UI.Models
@using CyberQuiz.UI.Services
@using CyberQuiz.UI.Components.Shared
@inject IApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>@pageTitle</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="quiz-page page-content">
            <NavLink class="btn btn-link px-0 mb-3" href="@(categoryId is not null ? $"/categories/{categoryId}" : "/categories")">← Back to subcategories</NavLink>

            <h3 class="mb-3">@headingTitle</h3>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }
            else if (questions.Count == 0)
            {
                <div class="alert alert-info">No questions found for this subcategory.</div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @for (var i = 0; i < questions.Count; i++)
                    {
                        var question = questions[i];
                        
                        <QuestionCard Title="@($"Question {question.OrderIndex}")"
                                      QuestionText="@question.Text"
                                      AnswerOptions="@GetAnswerOptions(question)"
                                      SelectedAnswerOptionId="@GetSelectedOptionId(question.QuestionId)"
                                      GroupName="@($"q-{question.QuestionId}")"
                                      AriaLabel="@($"Answers for question {i + 1}")"
                                      IsReadOnly="@hasSubmittedCurrentQuestion"
                                      OnSelectOption="@((optionId) => SelectOption(question.QuestionId, optionId))">
                            <ActionContent>
                                <button class="btn btn-primary"
                                        @onclick="() => SubmitAnswerAsync(question.QuestionId)"
                                        disabled="@(!hasSelectedAnswer || hasSubmittedCurrentQuestion)">
                                    Submit answer
                                </button>
                                
                                @if (question.IsLastQuestion)
                                {
                                    <button class="btn btn-outline-primary"
                                            @onclick="GoToReviewAsync"
                                            disabled="@(!hasSubmittedCurrentQuestion)">
                                        Review results
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-outline-primary"
                                            @onclick="GoToNextQuestionAsync"
                                            disabled="@(!hasSubmittedCurrentQuestion)">
                                        Next question
                                    </button>
                                }
                                
                                <button class="btn btn-outline-primary"
                                        @onclick="LoadQuizHelp"
                                        disabled="@(!hasSubmittedCurrentQuestion)">
                                    AI Quiz Help
                                </button>
                            </ActionContent>
                        </QuestionCard>
                    }
                </div>
            }
        </div>
        <br />
        <div class="mb-5 quiz-help">
            @if (isQuizHelpLoading)
            {
                <div class="card mb-3">
                    <div class="card-body d-flex flex-column align-items-center justify-content-center py-4 text-center">
                        <div class="spinner-border text-primary mb-2" role="status" aria-hidden="true"></div>
                        <div class="fw-semibold">Generating quiz help…</div>
                        <div class="text-secondary small">This can take a moment.</div>
                    </div>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(quizHelpReply))
            {
                <div class="alert alert-info">@FormatQuizHelpReply(quizHelpReply)</div>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <p>You must be logged in to view this page.</p>
        <NavLink class="btn btn-primary" href="/login">Go to Login</NavLink>
    </NotAuthorized>
</AuthorizeView>

<br />

@code {
    [Parameter]
    public int SubCategoryId { get; set; }

    private List<QuestionDto> questions = [];
    private string? errorMessage;
    private readonly Dictionary<int, int> selectedAnswersByQuestion = [];

    private int? categoryId;
    private string? categoryName;
    private string? subCategoryName;

    private string pageTitle = "Questions";
    private string headingTitle = "Questions";

    public int? questionId { get; set; }
    public int? selectedAnswerOptionId { get; set; }

    private int? correctAnswerOptionId;

    private bool hasSelectedAnswer;
    private bool hasSubmittedCurrentQuestion;

    private string? quizHelpReply;
    private bool isQuizHelpLoading;

    protected override async Task OnParametersSetAsync()
    {
        await LoadCategoryContextAsync();
        await LoadNextQuestionAsync();
    }

    private async Task LoadCategoryContextAsync()
    {
        var categories = await ApiClient.HttpClient
            .GetFromJsonAsync<List<CategoryDto>>("api/categories")
            ?? new List<CategoryDto>();

        var category = categories.FirstOrDefault(c => c.SubCategories.Any(sc => sc.Id == SubCategoryId));
        categoryId = category?.Id;
        categoryName = category?.Name;
        subCategoryName = category?.SubCategories.FirstOrDefault(sc => sc.Id == SubCategoryId)?.Name;

        var titleParts = new[] { categoryName, subCategoryName }
            .Where(value => !string.IsNullOrWhiteSpace(value));
        var displayTitle = string.Join(" · ", titleParts);

        pageTitle = string.IsNullOrWhiteSpace(displayTitle) ? "Questions" : $"{displayTitle} - Questions";
        headingTitle = string.IsNullOrWhiteSpace(displayTitle) ? "Questions" : displayTitle;
    }

    private async Task LoadNextQuestionAsync()
    {
        try
        {
            errorMessage = null;
            var nextQuestion = await ApiClient.HttpClient.GetFromJsonAsync<QuestionDto>($"api/quiz/next/{SubCategoryId}");
            questions = nextQuestion is null ? [] : [nextQuestion];
            selectedAnswersByQuestion.Clear();

            questionId = nextQuestion?.QuestionId;
            selectedAnswerOptionId = null;
            correctAnswerOptionId = null;
            hasSelectedAnswer = false;
            hasSubmittedCurrentQuestion = false;
            quizHelpReply = null;
            isQuizHelpLoading = false;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            questions = [];
            selectedAnswersByQuestion.Clear();
            questionId = null;
            selectedAnswerOptionId = null;
            correctAnswerOptionId = null;
            hasSelectedAnswer = false;
            hasSubmittedCurrentQuestion = false;
            quizHelpReply = null;
            isQuizHelpLoading = false;
        }
    }

    private bool IsSelected(int questionId, int optionId)
        => selectedAnswersByQuestion.TryGetValue(questionId, out var selectedOptionId) && selectedOptionId == optionId;

    private void SelectOption(int questionId, int optionId)
    {
        selectedAnswersByQuestion[questionId] = optionId;
        selectedAnswerOptionId = optionId;
        hasSelectedAnswer = true;
        hasSubmittedCurrentQuestion = false; // nytt val => måste submit igen
    }

    private async Task SubmitAnswerAsync(int questionId)
    {
        if (!hasSelectedAnswer || selectedAnswerOptionId is null)
            return;

        try
        {
            errorMessage = null;

            var dto = new SubmitAnswerRequestDto
            {
                SubCategoryId = SubCategoryId,
                QuestionId = questionId,
                SelectedAnswerOptionId = selectedAnswerOptionId.Value
            };

            var response = await ApiClient.HttpClient.PostAsJsonAsync("api/quiz/answer", dto);
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await response.Content.ReadAsStringAsync();
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<SubmitAnswerResponseDto>();
            correctAnswerOptionId = result?.CorrectAnswerOptionId;

            hasSubmittedCurrentQuestion = true;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task GoToNextQuestionAsync()
    {
        if (!hasSubmittedCurrentQuestion)
            return;

        await LoadNextQuestionAsync();
    }

    private Task GoToReviewAsync()
    {
        if (!hasSubmittedCurrentQuestion)
            return Task.CompletedTask;

        Navigation.NavigateTo($"/review/{SubCategoryId}");
        return Task.CompletedTask;
    }

    private IReadOnlyList<AnswerOptionViewModel> GetAnswerOptions(QuestionDto question)
    {
        var selectedOptionId = GetSelectedOptionId(question.QuestionId);

        return question.AnswerOptions
            .Select(option => new AnswerOptionViewModel
            {
                Id = option.Id,
                Text = option.Text,
                IsCorrect = hasSubmittedCurrentQuestion
                            && correctAnswerOptionId.HasValue
                            && option.Id == correctAnswerOptionId.Value,
                IsSelectedByUser = selectedOptionId.HasValue && option.Id == selectedOptionId.Value
            })
            .ToList();
    }

    private int? GetSelectedOptionId(int questionId)
        => selectedAnswersByQuestion.TryGetValue(questionId, out var selectedOptionId)
            ? selectedOptionId
            : null;

    private async Task LoadQuizHelp()
    {
        if (questions.Count == 0 || questionId is null || selectedAnswerOptionId is null)
            return;

        try
        {
            isQuizHelpLoading = true;
            errorMessage = null;
            quizHelpReply = null;

            var question = questions[0];
            var userAnswer = question.AnswerOptions.FirstOrDefault(ao => ao.Id == selectedAnswerOptionId.Value);
            var correctAnswer = question.AnswerOptions.FirstOrDefault(ao => ao.Id == correctAnswerOptionId);

            var dto = new QuizHelpRequestDto
            {
                QuestionId = questionId.Value,
                QuestionText = question.Text,
                UserAnswer = userAnswer?.Text,
                CorrectAnswer = correctAnswer?.Text ?? string.Empty,
                Explanation = "Explanation placeholder", //question.Explanation,
                WasUserAnswerCorrect = selectedAnswerOptionId == correctAnswerOptionId
            };

            var response = await ApiClient.HttpClient.PostAsJsonAsync("api/ai/quiz-help", dto);
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await response.Content.ReadAsStringAsync();
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<ChatResponseDto>();
            quizHelpReply = result?.Reply;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isQuizHelpLoading = false;
        }
    }

    private static MarkupString FormatQuizHelpReply(string reply)
    {
        var encoded = WebUtility.HtmlEncode(reply);
        var withBreaks = encoded
            .Replace("\r\n", "\n")
            .Replace("\n", "<br />");

        return new MarkupString(withBreaks);
    }
}