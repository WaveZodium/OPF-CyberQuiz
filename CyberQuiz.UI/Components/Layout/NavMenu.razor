@using CyberQuiz.UI.Services
@inject IApiClient Api
@inject IJSRuntime Js
@inject NavigationManager Nav

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">CyberQuiz.UI</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized Context="authState">
                <div class="nav-item px-3">
                    <span class="nav-link">Hej @authState.User.Identity?.Name</span>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="categories">
                        <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Categories
                    </NavLink>
                </div>
                @if (authState.User.IsInRole("Admin"))
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="admin">Admin</NavLink>
                    </div>
                }
                <div class="nav-item px-3">
                    <button class="btn btn-link nav-link" @onclick="LogoutAsync">
                        <span class="bi bi-box-arrow-right" aria-hidden="true"></span> Logout
                    </button>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">
                        <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Login
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="register">
                        <span class="bi bi-person-plus-fill" aria-hidden="true"></span> Register
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private async Task LogoutAsync()
    {
        var url = new Uri(Api.HttpClient.BaseAddress!, "api/auth/logout");
        await Js.InvokeAsync<bool>("cyberQuizAuth.postJson", url.ToString(), null);
        Nav.NavigateTo("/", forceLoad: true);
    }
}